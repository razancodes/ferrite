{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ferrite chat",
  "version": "0.2.0",
  "identifier": "dev.ferrite.chat",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ferrite chat",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0E0D0A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}